// DHARMAPATI — Security Guard Management & Patrol Tracking System
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  SUPERVISOR
  GUARD
  CLIENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  RESIGNED
}

enum ScheduleStatus {
  PLANNED
  CONFIRMED
  ABSENT
  SWAPPED
  DONE
}

enum AttendanceStatus {
  ON_TIME
  LATE
  ABSENT
  EARLY_LEAVE
}

enum PatrolStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum ScanMethod {
  QR
  NFC
  GPS
  MANUAL
}

enum CheckpointCondition {
  AMAN
  PERLU_PERHATIAN
  BERMASALAH
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  IN_REVIEW
  ESCALATED
  RESOLVED
  CLOSED
}

enum PanicStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

/// Jenis keadaan darurat. Tiap jenis diteruskan ke divisi penanggap
/// yang berbeda, sesuai pemetaan pada PanicRoute.
/// Jenis pelanggaran integritas yang terdeteksi sistem.
enum IntegrityType {
  /// Perangkat melaporkan koordinat palsu (mock location)
  LOKASI_PALSU
  /// Perpindahan mustahil menurut jarak dan waktu antar-catatan
  KECEPATAN_TIDAK_WAJAR
  /// Aplikasi berjalan di emulator, bukan ponsel sungguhan
  EMULATOR
  /// Masuk dari perangkat yang tidak terdaftar untuk akun ini
  PERANGKAT_ASING
  /// Perangkat terindikasi di-root
  PERANGKAT_ROOT
}

enum DeviceStatus {
  AKTIF
  DIBLOKIR
}

enum PanicType {
  /// Anggota tidak bergerak atau tidak menjawab pemeriksaan berkala —
  /// dikirim otomatis oleh aplikasi, bukan ditekan orang.
  MAN_DOWN
  UMUM
  KEBAKARAN
  KECELAKAAN
  MEDIS
  KRIMINAL
  BENCANA
}

/// Cara sistem menyalakan sirene. Sebagian besar papan relai di lapangan
/// (Shelly, Tasmota, ESP32) cukup dipanggil dengan HTTP GET; perangkat yang
/// lebih baru umumnya menerima JSON.
enum AlarmDriver {
  HTTP_GET
  HTTP_JSON
}

enum AlarmAction {
  ON
  OFF
}

enum AlarmSource {
  PANIC
  MANUAL
  UJI
}

enum VisitorStatus {
  INSIDE
  CHECKED_OUT
  DENIED
}

enum EquipmentStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  LOST
  DAMAGED
}


enum TaskPriority {
  RENDAH
  NORMAL
  TINGGI
  MENDESAK
}

enum TaskStatus {
  BARU
  DIKERJAKAN
  SELESAI
  DIBATALKAN
}

enum AssessorRole {
  DANRU
  KLIEN
}

enum LeaveType {
  CUTI
  IZIN
  LEMBUR
}

enum LeaveStatus {
  DIAJUKAN
  DISETUJUI
  DITOLAK
}

enum AttemptResult {
  DILUAR_RADIUS
  WAJAH_TIDAK_COCOK
  WAJAH_TIDAK_TERDETEKSI
  SUDAH_MASUK
  LAINNYA
}

model User {
  id           String     @id @default(cuid())
  employeeId   String?    @unique
  username     String     @unique
  name         String
  email        String?    @unique
  phone        String?
  passwordHash String
  role         Role       @default(GUARD)
  status       UserStatus @default(ACTIVE)
  avatarUrl    String?
  /// Untuk role CLIENT: dikunci ke satu perusahaan klien
  clientId     String?
  client       Client?    @relation(fields: [clientId], references: [id])
  /// Untuk role GUARD: penempatan utama
  homeSiteId   String?
  homeSite     Site?      @relation("HomeSite", fields: [homeSiteId], references: [id])
  rank         String?
  /// Ciri wajah terdaftar (vektor 128 dimensi) untuk verifikasi presensi
  faceTemplate Json?
  faceEnrolledAt DateTime?
  teamId       String?
  team         Team?      @relation(fields: [teamId], references: [id])
  joinedAt     DateTime?
  lastLoginAt  DateTime?
  deviceToken  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  schedules        Schedule[]
  attendances      Attendance[]
  patrols          PatrolSession[]
  incidentsFiled   Incident[]      @relation("Reporter")
  incidentsOwned   Incident[]      @relation("Assignee")
  incidentUpdates  IncidentUpdate[]
  panics           PanicAlert[]    @relation("PanicGuard")
  panicsAcked      PanicAlert[]    @relation("PanicAck")
  pings            LocationPing[]
  handoversFrom    Handover[]      @relation("HandoverFrom")
  handoversTo      Handover[]      @relation("HandoverTo")
  equipment        Equipment[]
  notifications    Notification[]
  announcements    Announcement[]
  auditLogs        AuditLog[]
  visitorsHandled  Visitor[]
  vehicleLogs      VehicleLog[]
  tasksAssigned    Task[]           @relation("TaskPetugas")
  tasksCreated     Task[]           @relation("TaskPembuat")
  instructionsSent Instruction[]
  instructionReads InstructionRead[]
  assessmentsGiven Assessment[]     @relation("Penilai")
  assessmentsGot   Assessment[]     @relation("Dinilai")
  leaveRequests    LeaveRequest[]   @relation("Pemohon")
  leaveApprovals   LeaveRequest[]   @relation("Penyetuju")
  attendanceAttempts AttendanceAttempt[]

  @@index([role, status])
  divisionId       String?
  division         EmergencyDivision? @relation("DivisionMembers", fields: [divisionId], references: [id])
  devices          UserDevice[]
  integrityEvents  IntegrityEvent[]

  /// ── Data kepegawaian untuk penggajian ──
  gradeId         String?
  grade           PayGrade?   @relation(fields: [gradeId], references: [id])
  bankName        String?
  bankAccount     String?
  bankAccountName String?
  npwp            String?
  ptkp            PtkpStatus? @default(TK0)
  bpjsTkNo        String?
  bpjsKesNo       String?
  resignedAt      DateTime?

  /// Personel yang tidak boleh dipekerjakan lagi — dicegah saat penjadwalan
  blacklisted     Boolean     @default(false)
  blacklistReason String?

  reliefOffersMade  ReliefOffer[]     @relation("PembuatTawaran")
  reliefOffersTaken ReliefOffer[]     @relation("PengambilTawaran")
  reliefCandidacies ReliefCandidate[] @relation("CalonPengganti")

  documents       PersonnelDocument[] @relation("BerkasPersonel")
  documentsChecked PersonnelDocument[] @relation("PemeriksaBerkas")
  disciplines     Discipline[]        @relation("PenerimaSanksi")
  disciplinesIssued Discipline[]      @relation("PemberiSanksi")
  employmentContracts EmploymentContract[] @relation("KontrakKerja")

  payslips        Payslip[]
  payrollRuns     PayrollRun[]   @relation("PayrollPembuat")
  loans           EmployeeLoan[] @relation("PeminjamKasbon")
  loansApproved   EmployeeLoan[] @relation("PenyetujuKasbon")
  paymentsTaken   Payment[]      @relation("PenerimaBayar")
  expensesLogged  SiteExpense[]  @relation("PencatatBiaya")
}

model Client {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  provinceCode String?
  provinceName String?
  regencyCode  String?
  regencyName  String?
  districtCode String?
  districtName String?
  villageCode  String?
  villageName  String?
  postalCode   String?
  logoUrl     String?
  contractNo  String?
  contractEnd DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sites Site[]
  users User[]

  contracts Contract[]
  invoices  Invoice[]
}

model Site {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  code      String   @unique
  name      String
  address   String?
  city      String?
  /// Alamat berjenjang. Kode disimpan untuk penelusuran, namanya ikut
  /// disimpan agar laporan dan ekspor tidak perlu menggabung tabel.
  provinceCode String?
  provinceName String?
  regencyCode  String?
  regencyName  String?
  districtCode String?
  districtName String?
  villageCode  String?
  villageName  String?
  postalCode   String?
  lat       Float
  lng       Float
  /// Radius geofence area site (meter)
  radiusM   Int      @default(200)
  timezone  String   @default("Asia/Jakarta")
  photoUrl  String?
  picName   String?
  picPhone  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zones       Zone[]
  checkpoints Checkpoint[]
  routes      PatrolRoute[]
  shifts      Shift[]
  schedules   Schedule[]
  attendances Attendance[]
  patrols     PatrolSession[]
  incidents   Incident[]
  panics      PanicAlert[]
  visitors    Visitor[]
  vehicles    VehicleLog[]
  handovers   Handover[]
  equipment   Equipment[]
  homeUsers   User[]          @relation("HomeSite")
  floors      Floor[]
  teams       Team[]
  tasks       Task[]
  instructions Instruction[]
  attendanceAttempts AttendanceAttempt[]

  @@index([clientId])
  divisions   EmergencyDivision[]
  panicRoutes PanicRoute[]
  alarms      AlarmDevice[]
  integrityEvents IntegrityEvent[]

  payslips      Payslip[]
  reliefOffers  ReliefOffer[]
  competencies  CompetencyRequirement[]
  contractPosts ContractPost[]
  invoiceLines  InvoiceLine[]
  expenses      SiteExpense[]
}

model Zone {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("#F5A524")
  riskLevel Severity @default(LOW)
  createdAt DateTime @default(now())

  checkpoints Checkpoint[]

  @@index([siteId])
}

model Checkpoint {
  id          String   @id @default(cuid())
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  zoneId      String?
  zone        Zone?    @relation(fields: [zoneId], references: [id])
  code        String   @unique
  name        String
  description String?
  lat         Float
  lng         Float
  /// Toleransi jarak scan GPS (meter)
  radiusM     Int      @default(30)
  nfcTag      String?
  photoUrl    String?
  floorId     String?
  floor       Floor?   @relation(fields: [floorId], references: [id])
  /// Posisi titik pada denah lantai, dalam persen 0–100 dari sisi kiri & atas
  planX       Float?
  planY       Float?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  routeLinks RouteCheckpoint[]
  scans      PatrolScan[]

  @@index([siteId])
}

model PatrolRoute {
  id                  String   @id @default(cuid())
  siteId              String
  site                Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  /// Estimasi durasi normal satu putaran (menit)
  expectedDurationMin Int      @default(45)
  /// Toleransi keterlambatan per checkpoint (menit)
  graceMin            Int      @default(10)
  /// Wajib scan berurutan sesuai orderIndex
  enforceOrder        Boolean  @default(false)
  requirePhoto        Boolean  @default(false)
  /// Setiap titik wajib dilaporkan kondisinya sebelum titik berikutnya boleh
  /// dipindai. Inilah yang membuat patroli menghasilkan catatan, bukan sekadar
  /// jejak lewat.
  requireReport       Boolean  @default(true)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  checkpoints RouteCheckpoint[]
  sessions    PatrolSession[]
  schedules   Schedule[]

  @@index([siteId])
}

model RouteCheckpoint {
  id           String      @id @default(cuid())
  routeId      String
  route        PatrolRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  checkpointId String
  checkpoint   Checkpoint  @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  orderIndex   Int
  /// Menit sejak patroli dimulai, target tiba di titik ini
  targetMinute Int         @default(0)

  @@unique([routeId, checkpointId])
  @@index([routeId, orderIndex])
}

model Shift {
  id              String   @id @default(cuid())
  siteId          String
  site            Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name            String
  /// Format HH:mm
  startTime       String
  endTime         String
  crossesMidnight Boolean  @default(false)
  /// Toleransi telat (menit) sebelum dihitung LATE
  lateToleranceMin Int     @default(10)
  color           String   @default("#22D3EE")
  createdAt       DateTime @default(now())

  schedules     Schedule[]
  contractPosts ContractPost[]
  reliefOffers  ReliefOffer[]

  @@index([siteId])
}

model Schedule {
  id        String         @id @default(cuid())
  siteId    String
  site      Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  shiftId   String
  shift     Shift          @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  guardId   String
  guard     User           @relation(fields: [guardId], references: [id], onDelete: Cascade)
  routeId   String?
  route     PatrolRoute?   @relation(fields: [routeId], references: [id])
  /// Tanggal jaga (UTC midnight)
  date      DateTime
  status    ScheduleStatus @default(PLANNED)
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  attendance Attendance?
  patrols    PatrolSession[]
  reliefOffers ReliefOffer[]

  @@unique([guardId, date, shiftId])
  @@index([siteId, date])
}

model Attendance {
  id             String           @id @default(cuid())
  scheduleId     String?          @unique
  schedule       Schedule?        @relation(fields: [scheduleId], references: [id])
  guardId        String
  guard          User             @relation(fields: [guardId], references: [id], onDelete: Cascade)
  siteId         String
  site           Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  checkInAt      DateTime?
  checkInLat     Float?
  checkInLng     Float?
  checkInPhoto   String?
  checkInDistanceM Int?
  checkOutAt     DateTime?
  checkOutLat    Float?
  checkOutLng    Float?
  checkOutPhoto  String?
  status         AttendanceStatus @default(ON_TIME)
  /// Skor kemiripan wajah 0–100 saat presensi masuk
  faceScore      Float?
  lateMinutes    Int              @default(0)
  workedMinutes  Int              @default(0)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([guardId, checkInAt])
  @@index([siteId, checkInAt])
  /// Waktu yang dilaporkan perangkat saat kejadian ini sempat mengantre
  /// tanpa jaringan. Waktu resmi tetap milik server (BRULE-008); kolom ini
  /// hanya menerangkan bahwa catatan menyusul, bukan menggantikannya.
  offlineAt   DateTime?
}

model PatrolSession {
  id               String       @id @default(cuid())
  siteId           String
  site             Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  routeId          String
  route            PatrolRoute  @relation(fields: [routeId], references: [id])
  guardId          String
  guard            User         @relation(fields: [guardId], references: [id], onDelete: Cascade)
  scheduleId       String?
  schedule         Schedule?    @relation(fields: [scheduleId], references: [id])
  startedAt        DateTime     @default(now())
  endedAt          DateTime?
  status           PatrolStatus @default(IN_PROGRESS)
  totalCheckpoints Int          @default(0)
  scannedCount     Int          @default(0)
  missedCount      Int          @default(0)
  issueCount       Int          @default(0)
  /// Persentase kepatuhan 0-100
  complianceRate   Float        @default(0)
  distanceM        Int          @default(0)
  durationMin      Int          @default(0)
  notes            String?
  createdAt        DateTime     @default(now())

  scans PatrolScan[]
  pings LocationPing[]

  @@index([siteId, startedAt])
  @@index([guardId, startedAt])
}

model PatrolScan {
  id           String              @id @default(cuid())
  sessionId    String
  session      PatrolSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  checkpointId String
  checkpoint   Checkpoint          @relation(fields: [checkpointId], references: [id])
  scannedAt    DateTime            @default(now())
  method       ScanMethod          @default(QR)
  lat          Float?
  lng          Float?
  distanceM    Int?
  photoUrl     String?
  note         String?
  condition    CheckpointCondition @default(AMAN)
  isLate       Boolean             @default(false)
  orderIndex   Int                 @default(0)
  /// Waktu laporan titik ini diisi. Selama masih null dan rutenya mewajibkan
  /// laporan, titik berikutnya tidak dapat dipindai.
  reportedAt   DateTime?
  /// Ditandai bila jarak pemindaian jauh di luar toleransi titik
  distanceFlag Boolean             @default(false)

  @@unique([sessionId, checkpointId])
  @@index([checkpointId, scannedAt])
  /// Waktu yang dilaporkan perangkat saat kejadian ini sempat mengantre
  /// tanpa jaringan. Waktu resmi tetap milik server (BRULE-008); kolom ini
  /// hanya menerangkan bahwa catatan menyusul, bukan menggantikannya.
  offlineAt   DateTime?
}

model Incident {
  id          String         @id @default(cuid())
  code        String         @unique
  siteId      String
  site        Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  reporterId  String
  reporter    User           @relation("Reporter", fields: [reporterId], references: [id])
  assigneeId  String?
  assignee    User?          @relation("Assignee", fields: [assigneeId], references: [id])
  category    String
  severity    Severity       @default(MEDIUM)
  status      IncidentStatus @default(OPEN)
  title       String
  description String
  lat         Float?
  lng         Float?
  locationHint String?
  occurredAt  DateTime       @default(now())
  slaDueAt    DateTime?
  resolvedAt  DateTime?
  closedAt    DateTime?
  lossValue   Decimal?       @db.Decimal(16, 2)
  closingNote String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  media   IncidentMedia[]
  updates IncidentUpdate[]
  disciplines Discipline[]

  @@index([siteId, status])
  @@index([status, severity])
  /// Waktu yang dilaporkan perangkat saat kejadian ini sempat mengantre
  /// tanpa jaringan. Waktu resmi tetap milik server (BRULE-008); kolom ini
  /// hanya menerangkan bahwa catatan menyusul, bukan menggantikannya.
  offlineAt   DateTime?
}

model IncidentMedia {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  url        String
  mimeType   String   @default("image/jpeg")
  caption    String?
  createdAt  DateTime @default(now())

  @@index([incidentId])
}

model IncidentUpdate {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  note       String?
  createdAt  DateTime @default(now())

  @@index([incidentId])
}

model PanicAlert {
  id              String      @id @default(cuid())
  guardId         String
  guard           User        @relation("PanicGuard", fields: [guardId], references: [id], onDelete: Cascade)
  siteId          String
  site            Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  lat             Float?
  lng             Float?
  message         String?
  /// Jenis keadaan darurat yang dipilih petugas di lapangan
  type            PanicType   @default(UMUM)
  /// Lantai terakhir berdasarkan titik QR yang terakhir dipindai
  floorId         String?
  floor           Floor?      @relation(fields: [floorId], references: [id])
  /// Ringkasan divisi yang menerima pemberitahuan, disimpan apa adanya
  /// agar riwayat tetap terbaca walau pemetaan divisi kemudian diubah.
  notifiedDivisions Json?
  alarmEvents     AlarmEvent[]
  status          PanicStatus @default(ACTIVE)
  acknowledgedById String?
  acknowledgedBy  User?       @relation("PanicAck", fields: [acknowledgedById], references: [id])
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?
  responseNote    String?
  createdAt       DateTime    @default(now())

  @@index([status, createdAt])
  /// Waktu yang dilaporkan perangkat saat kejadian ini sempat mengantre
  /// tanpa jaringan. Waktu resmi tetap milik server (BRULE-008); kolom ini
  /// hanya menerangkan bahwa catatan menyusul, bukan menggantikannya.
  offlineAt   DateTime?
}

model LocationPing {
  id         String         @id @default(cuid())
  guardId    String
  guard      User           @relation(fields: [guardId], references: [id], onDelete: Cascade)
  sessionId  String?
  session    PatrolSession? @relation(fields: [sessionId], references: [id])
  lat        Float
  lng        Float
  accuracyM  Float?
  speedKph   Float?
  batteryPct Int?
  recordedAt DateTime       @default(now())

  @@index([guardId, recordedAt])
  @@index([sessionId])
}

model Visitor {
  id          String        @id @default(cuid())
  siteId      String
  site        Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  handledById String?
  handledBy   User?         @relation(fields: [handledById], references: [id])
  badgeNo     String?
  name        String
  idType      String        @default("KTP")
  idNumber    String?
  company     String?
  phone       String?
  purpose     String
  hostName    String?
  vehiclePlate String?
  photoUrl    String?
  itemsBrought String?
  checkInAt   DateTime      @default(now())
  checkOutAt  DateTime?
  status      VisitorStatus @default(INSIDE)
  notes       String?

  @@index([siteId, checkInAt])
}

model VehicleLog {
  id          String    @id @default(cuid())
  siteId      String
  site        Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  recordedById String?
  recordedBy  User?     @relation(fields: [recordedById], references: [id])
  plate       String
  vehicleType String    @default("MOBIL")
  driverName  String?
  company     String?
  purpose     String?
  cargo       String?
  inAt        DateTime  @default(now())
  outAt       DateTime?
  photoUrl    String?
  notes       String?

  @@index([siteId, inAt])
}

model Handover {
  id          String   @id @default(cuid())
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  fromGuardId String
  fromGuard   User     @relation("HandoverFrom", fields: [fromGuardId], references: [id])
  toGuardId   String
  toGuard     User     @relation("HandoverTo", fields: [toGuardId], references: [id])
  shiftDate   DateTime
  situation   String
  pendingWork String?
  equipmentOk Boolean  @default(true)
  equipmentNote String?
  signatureUrl String?
  acknowledgedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([siteId, shiftDate])
}

model Equipment {
  id           String          @id @default(cuid())
  siteId       String
  site         Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  code         String          @unique
  name         String
  category     String          @default("UMUM")
  serialNumber String?
  status       EquipmentStatus @default(AVAILABLE)
  assignedToId String?
  assignedTo   User?           @relation(fields: [assignedToId], references: [id])
  assignedAt   DateTime?
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([siteId, status])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  audience    String   @default("ALL")
  siteId      String?
  priority    Severity @default(LOW)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  publishedAt DateTime @default(now())
  expiresAt   DateTime?

  @@index([publishedAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, createdAt])
}


/// Lantai pada satu site beserta denah skematiknya (FR-MST-002, FR-GPS-003)
model Floor {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name      String
  level     Int      @default(0)
  planUrl   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checkpoints Checkpoint[]
  panics      PanicAlert[]

  @@index([siteId, level])
  alarms      AlarmDevice[]
}

/// Regu jaga (FR-MST-005)
model Team {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name      String
  code      String   @unique
  leaderId  String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      User[]
  instructions Instruction[]

  @@index([siteId])
}

/// Pekerjaan insidental (FR-TASK-001..002)
model Task {
  id          String       @id @default(cuid())
  siteId      String
  site        Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  assigneeId  String
  assignee    User         @relation("TaskPetugas", fields: [assigneeId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User         @relation("TaskPembuat", fields: [createdById], references: [id])
  title       String
  description String?
  priority    TaskPriority @default(NORMAL)
  status      TaskStatus   @default(BARU)
  dueAt       DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  result      String?
  proofUrls   Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([assigneeId, status])
  @@index([siteId, createdAt])
}

/// Instruksi kepada individu atau regu (FR-TASK-003..004)
model Instruction {
  id        String   @id @default(cuid())
  siteId    String?
  site      Site?    @relation(fields: [siteId], references: [id])
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  teamId    String?
  team      Team?    @relation(fields: [teamId], references: [id])
  title     String
  body      String
  urgent    Boolean  @default(false)
  createdAt DateTime @default(now())

  reads InstructionRead[]

  @@index([createdAt])
}

model InstructionRead {
  id            String      @id @default(cuid())
  instructionId String
  instruction   Instruction @relation(fields: [instructionId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt        DateTime    @default(now())

  @@unique([instructionId, userId])
}

/// Penilaian manual oleh Danru dan Klien (FR-KPI-002)
model Assessment {
  id          String       @id @default(cuid())
  guardId     String
  guard       User         @relation("Dinilai", fields: [guardId], references: [id], onDelete: Cascade)
  assessorId  String
  assessor    User         @relation("Penilai", fields: [assessorId], references: [id])
  assessorRole AssessorRole
  /// Periode penilaian dalam format YYYY-MM
  period      String
  disiplin    Int
  penampilan  Int
  responsif   Int
  kualitasLaporan Int
  komunikasi  Int
  note        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([guardId, assessorId, period])
  @@index([guardId, period])
}

/// Pengajuan cuti, izin, dan lembur beserta persetujuannya
model LeaveRequest {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation("Pemohon", fields: [userId], references: [id], onDelete: Cascade)
  type       LeaveType   @default(CUTI)
  startDate  DateTime
  endDate    DateTime
  hours      Float?
  reason     String
  status     LeaveStatus @default(DIAJUKAN)
  approverId String?
  approver   User?       @relation("Penyetuju", fields: [approverId], references: [id])
  decidedAt  DateTime?
  decisionNote String?
  createdAt  DateTime    @default(now())

  @@index([userId, status])
}

/// Percobaan presensi yang ditolak, disimpan sebagai bukti (FR-ATT-006)
model AttendanceAttempt {
  id         String        @id @default(cuid())
  guardId    String
  guard      User          @relation(fields: [guardId], references: [id], onDelete: Cascade)
  siteId     String
  site       Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  result     AttemptResult
  reason     String
  lat        Float?
  lng        Float?
  distanceM  Int?
  faceScore  Float?
  photoUrl   String?
  createdAt  DateTime      @default(now())

  @@index([guardId, createdAt])
  @@index([siteId, createdAt])
  deviceId  String?
  mocked    Boolean  @default(false)
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}


/// Divisi penanggap keadaan darurat: pemadam, klinik, K3, dan sebagainya.
model EmergencyDivision {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  /// Nomor yang dihubungi bila tidak ada anggota divisi yang memegang akun
  phone     String?
  email     String?
  /// Kosong berarti divisi berlaku untuk seluruh site
  siteId    String?
  site      Site?    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  members   User[]   @relation("DivisionMembers")
  routes    PanicRoute[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
}

/// Pemetaan jenis darurat ke divisi penanggap. Baris tanpa siteId berlaku
/// sebagai aturan umum; baris dengan siteId menimpanya untuk site tersebut.
model PanicRoute {
  id         String            @id @default(cuid())
  type       PanicType
  divisionId String
  division   EmergencyDivision @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  siteId     String?
  site       Site?             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now())

  @@unique([type, divisionId, siteId])
  @@index([siteId, type])
}

/// Sirene atau pengeras suara yang terpasang di tiang.
model AlarmDevice {
  id          String      @id @default(cuid())
  siteId      String
  site        Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  /// Bila diisi, sirene ini diutamakan saat kejadian berada di lantai tersebut
  floorId     String?
  floor       Floor?      @relation(fields: [floorId], references: [id])
  code        String      @unique
  name        String
  location    String?
  lat         Float?
  lng         Float?
  driver      AlarmDriver @default(HTTP_GET)
  /// Alamat yang dipanggil untuk menyalakan dan mematikan
  endpointOn  String
  endpointOff String?
  authToken   String?
  /// Lama bunyi otomatis dalam detik; 0 berarti berbunyi sampai dimatikan
  durationS   Int         @default(60)
  isActive    Boolean     @default(true)
  lastState   String?
  lastSeenAt  DateTime?
  events      AlarmEvent[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([siteId, isActive])
}

/// Riwayat perintah ke sirene, termasuk yang gagal — dipakai untuk
/// membuktikan alarm benar-benar dibunyikan saat kejadian.
model AlarmEvent {
  id        String      @id @default(cuid())
  deviceId  String
  device    AlarmDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  panicId   String?
  panic     PanicAlert? @relation(fields: [panicId], references: [id], onDelete: SetNull)
  action    AlarmAction
  source    AlarmSource @default(PANIC)
  ok        Boolean     @default(false)
  detail    String?
  latencyMs Int?
  triggeredById String?
  createdAt DateTime    @default(now())

  @@index([deviceId, createdAt])
  @@index([panicId])
}


/// Perangkat yang terikat pada satu akun.
///
/// Satu anggota hanya boleh memakai satu ponsel. Pengikatan terjadi pada masuk
/// pertama, dan hanya administrator yang dapat melepaskannya — sehingga akun
/// tidak dapat dipinjamkan begitu saja kepada rekan.
model UserDevice {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Penanda yang dibuat aplikasi dan disimpan di perangkat
  deviceId     String
  /// Ciri perangkat (merek|model|papan|versi) untuk mengenali ponsel yang sama
  /// setelah aplikasi dipasang ulang
  fingerprint  String?
  label        String?
  platform     String?
  osVersion    String?
  appVersion   String?
  status       DeviceStatus @default(AKTIF)
  isPhysical   Boolean      @default(true)
  firstSeenAt  DateTime     @default(now())
  lastSeenAt   DateTime     @default(now())
  releasedById String?
  note         String?

  @@unique([userId, deviceId])
  @@index([deviceId])
}

/// Catatan pelanggaran integritas: lokasi palsu, perpindahan mustahil,
/// emulator, atau masuk dari perangkat asing.
///
/// Tindakannya ditolak, tetapi percobaannya tetap disimpan — justru di situ
/// nilainya bagi pengawas.
model IntegrityEvent {
  id        String        @id @default(cuid())
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  siteId    String?
  site      Site?         @relation(fields: [siteId], references: [id], onDelete: SetNull)
  type      IntegrityType
  /// Tindakan yang sedang dicoba: PRESENSI_MASUK, PINDAI_TITIK, dan seterusnya
  action    String
  lat       Float?
  lng       Float?
  accuracyM Float?
  speedKph  Float?
  deviceId  String?
  detail    String?
  meta      Json?
  ip        String?
  createdAt DateTime      @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
}


// ═══════════════════════════════════════════════════════════════════════════
// PRIORITAS 1 — KEUANGAN: PENGUPAHAN, PENAGIHAN, LABA-RUGI PER SITE
//
// Catatan satuan uang: seluruh nilai rupiah disimpan sebagai Float dan selalu
// dibulatkan ke rupiah penuh sebelum disimpan (lihat lib/uang.ts). Bilangan
// bulat sampai 9×10^15 masih persis pada Float 64-bit, jadi tidak ada
// kehilangan sen; Decimal sengaja dihindari agar hasil API tetap berupa angka
// JSON, bukan string.
// ═══════════════════════════════════════════════════════════════════════════

enum PayrollType {
  BULANAN
  THR
}

enum PayrollStatus {
  DRAFT
  TERKUNCI
  DIBAYAR
}

enum LoanStatus {
  AKTIF
  LUNAS
  DIBATALKAN
}

/// Status PTKP menentukan kategori tarif efektif (TER) PPh 21.
enum PtkpStatus {
  TK0
  TK1
  TK2
  TK3
  K0
  K1
  K2
  K3
}

enum ContractStatus {
  DRAF
  AKTIF
  SELESAI
  BATAL
}

enum InvoiceStatus {
  DRAFT
  TERKIRIM
  SEBAGIAN
  LUNAS
  BATAL
}

enum InvoiceLineKind {
  POS
  TAMBAHAN
  POTONGAN
  DENDA
}

enum PenaltyKind {
  POS_KOSONG
  MANGKIR
  RONDE
  INSIDEN
  LAINNYA
}

enum PenaltyUnit {
  PER_KEJADIAN
  PER_HARI_ORANG
  PERSEN_TAGIHAN
}

/// Upah minimum kabupaten/kota per tahun — dasar penggajian dan kalkulator tender.
model MinimumWage {
  id     String  @id @default(cuid())
  region String
  year   Int
  amount Float
  note   String?

  @@unique([region, year])
}

/// Hari libur nasional — menentukan pengali lembur (Kepmen 102/2004).
model Holiday {
  id     String   @id @default(cuid())
  date   DateTime @unique
  name   String
  isNational Boolean @default(true)
}

/// Golongan upah: satu paket komponen gaji yang dipasang ke personel.
model PayGrade {
  id                String  @id @default(cuid())
  code              String  @unique
  name              String
  /// Wilayah UMK acuan, dicocokkan dengan MinimumWage.region
  region            String?
  baseSalary        Float
  /// Tunjangan tetap (jabatan/masa kerja) — ikut menjadi dasar lembur & BPJS
  positionAllowance Float   @default(0)
  /// Tunjangan tidak tetap, dibayar menurut kehadiran
  mealPerDay        Float   @default(0)
  transportPerDay   Float   @default(0)
  /// Bonus bila tidak ada mangkir sama sekali dalam satu periode
  attendanceBonus   Float   @default(0)
  /// Potongan per hari mangkir; 0 berarti dihitung upah sebulan ÷ hari kerja
  absentDeduction   Float   @default(0)
  latePenaltyPerMin Float   @default(0)
  bpjsTkEnrolled    Boolean @default(true)
  bpjsKesEnrolled   Boolean @default(true)
  /// Tarif JKK menurut kelompok risiko usaha (%)
  jkkRatePct        Float   @default(0.54)
  overtimeEligible  Boolean @default(true)
  isActive          Boolean @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  users    User[]
  payslips Payslip[]
  posts    ContractPost[]
}

/// Satu periode penggajian. Selama DRAFT boleh dihitung ulang berkali-kali;
/// setelah TERKUNCI angkanya beku dan menjadi dasar biaya pada laba-rugi.
model PayrollRun {
  id                String        @id @default(cuid())
  period            String
  type              PayrollType   @default(BULANAN)
  status            PayrollStatus @default(DRAFT)
  note              String?
  /// Hari kerja standar periode ini — dipakai untuk pro-rata dan potongan mangkir
  workingDays       Int           @default(0)
  totalGross        Float         @default(0)
  totalDeduction    Float         @default(0)
  totalNet          Float         @default(0)
  totalEmployerCost Float         @default(0)
  createdById       String?
  createdBy         User?         @relation("PayrollPembuat", fields: [createdById], references: [id])
  calculatedAt      DateTime?
  lockedAt          DateTime?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  payslips Payslip[]

  @@unique([period, type])
  @@index([status])
}

/// Slip gaji satu orang pada satu periode.
model Payslip {
  id      String     @id @default(cuid())
  runId   String
  run     PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  guardId String
  guard   User       @relation(fields: [guardId], references: [id], onDelete: Cascade)
  siteId  String?
  site    Site?      @relation(fields: [siteId], references: [id])
  gradeId String?
  grade   PayGrade?  @relation(fields: [gradeId], references: [id])

  /// Rekap kehadiran periode ini
  hariJadwal  Int   @default(0)
  hariHadir   Int   @default(0)
  hariMangkir Int   @default(0)
  menitTelat  Int   @default(0)
  jamLembur   Float @default(0)
  /// Masa kerja dalam bulan pada akhir periode — dasar pro-rata THR
  masaKerjaBulan Int @default(0)

  /// Upah sebulan (pokok + tunjangan tetap): dasar lembur, BPJS, dan THR
  upahDasar       Float @default(0)
  /// Rincian baris: [{ kode, label, jumlah, catatan? }]
  earnings        Json
  deductions      Json
  bruto           Float @default(0)
  totalPotongan   Float @default(0)
  netto           Float @default(0)
  pph21           Float @default(0)
  /// Kategori TER yang dipakai (A/B/C) atau "DESEMBER" untuk perhitungan tahunan
  pph21Basis      String?
  bpjsPekerja     Float @default(0)
  bpjsPerusahaan  Float @default(0)
  /// Total beban perusahaan = bruto + BPJS perusahaan (dipakai pada laba-rugi)
  biayaPerusahaan Float @default(0)

  /// Salinan data bank saat slip dibuat, agar berkas transfer tetap sahih
  bankName        String?
  bankAccount     String?
  bankAccountName String?
  note            String?
  createdAt       DateTime @default(now())

  loanPayments LoanPayment[]

  @@unique([runId, guardId])
  @@index([guardId])
  @@index([siteId])
}

/// Kasbon / pinjaman karyawan yang dipotong bertahap dari gaji.
model EmployeeLoan {
  id                String     @id @default(cuid())
  guardId           String
  guard             User       @relation("PeminjamKasbon", fields: [guardId], references: [id], onDelete: Cascade)
  amount            Float
  installmentCount  Int
  installmentAmount Float
  paidAmount        Float      @default(0)
  /// Periode pertama pemotongan (YYYY-MM)
  startPeriod       String
  reason            String?
  status            LoanStatus @default(AKTIF)
  approvedById      String?
  approvedBy        User?      @relation("PenyetujuKasbon", fields: [approvedById], references: [id])
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  payments LoanPayment[]

  @@index([guardId, status])
}

model LoanPayment {
  id        String       @id @default(cuid())
  loanId    String
  loan      EmployeeLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  payslipId String?
  payslip   Payslip?     @relation(fields: [payslipId], references: [id])
  period    String
  amount    Float
  createdAt DateTime     @default(now())

  @@unique([loanId, period])
}

/// Tarif Efektif Rata-rata PPh 21 bulanan (PMK 168/2023).
/// Nilai disimpan sebagai data, bukan kode, karena tabel resmi dapat berubah
/// dan harus dapat diperbarui admin tanpa penerapan ulang.
model TerBracket {
  id       String @id @default(cuid())
  category String
  minGross Float
  /// null berarti tidak terbatas
  maxGross Float?
  ratePct  Float

  @@unique([category, minGross])
  @@index([category])
}

// ─────────────── PENAGIHAN ───────────────

/// Kontrak jasa pengamanan dengan satu klien.
model Contract {
  id          String         @id @default(cuid())
  clientId    String
  client      Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  number      String         @unique
  title       String?
  startDate   DateTime
  endDate     DateTime
  /// Tanggal terbit tagihan tiap bulan
  billingDay  Int            @default(1)
  /// Termin pembayaran (hari) sejak tagihan terbit
  dueDays     Int            @default(14)
  managementFeePct Float     @default(0)
  /// Batas denda SLA sebulan, dalam persen nilai pos. Kontrak jasa pengamanan
  /// lazim membatasi denda agar tidak melampaui sebagian kecil nilai tagihan.
  penaltyCapPct Float        @default(10)
  ppnPct      Float          @default(11)
  pph23Pct    Float          @default(2)
  /// Klien memotong PPh 23 di muka (lazim untuk jasa keamanan)
  pph23Dipotong Boolean      @default(true)
  status      ContractStatus @default(AKTIF)
  note        String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  posts     ContractPost[]
  penalties PenaltyRule[]
  invoices  Invoice[]

  @@index([clientId, status])
}

/// Manning table (TOP): susunan pos yang diperjanjikan pada satu site.
model ContractPost {
  id           String  @id @default(cuid())
  contractId   String
  contract     Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  siteId       String
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  shiftId      String?
  shift        Shift?   @relation(fields: [shiftId], references: [id])
  positionName String
  headcount    Int      @default(1)
  /// Tarif jasa per orang per bulan yang ditagihkan ke klien
  ratePerPerson Float
  gradeId      String?
  grade        PayGrade? @relation(fields: [gradeId], references: [id])
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([contractId])
  @@index([siteId])
}

/// Aturan denda SLA yang disepakati dalam kontrak.
model PenaltyRule {
  id          String      @id @default(cuid())
  contractId  String
  contract    Contract    @relation(fields: [contractId], references: [id], onDelete: Cascade)
  kind        PenaltyKind
  description String
  amount      Float
  unit        PenaltyUnit @default(PER_KEJADIAN)
  /// Ambang toleransi sebelum denda berlaku (mis. 2 kejadian per bulan)
  threshold   Int         @default(0)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())

  @@index([contractId])
}

model Invoice {
  id         String        @id @default(cuid())
  contractId String
  contract   Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  clientId   String
  client     Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  number     String        @unique
  period     String
  issueDate  DateTime
  dueDate    DateTime
  status     InvoiceStatus @default(DRAFT)
  /// Nilai pos terpasang sebelum potongan
  subtotal       Float @default(0)
  deductionTotal Float @default(0)
  penaltyTotal   Float @default(0)
  additionTotal  Float @default(0)
  managementFee  Float @default(0)
  dpp            Float @default(0)
  ppn            Float @default(0)
  pph23          Float @default(0)
  total          Float @default(0)
  /// Yang benar-benar diterima setelah PPh 23 dipotong klien
  netReceivable  Float @default(0)
  paidTotal      Float @default(0)
  taxInvoiceNo   String?
  note           String?
  sentAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lines    InvoiceLine[]
  payments Payment[]

  // Sengaja bukan kunci unik: tagihan yang dibatalkan harus boleh diterbitkan
  // ulang pada periode yang sama. Pencegahan ganda dilakukan di routes/billing.ts
  // dengan mengabaikan tagihan berstatus BATAL.
  @@index([contractId, period])
  @@index([clientId, status])
}

model InvoiceLine {
  id          String          @id @default(cuid())
  invoiceId   String
  invoice     Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  kind        InvoiceLineKind @default(POS)
  siteId      String?
  site        Site?           @relation(fields: [siteId], references: [id])
  description String
  qty         Float           @default(1)
  unit        String?
  unitPrice   Float           @default(0)
  amount      Float           @default(0)
  /// Asal angka (rekonsiliasi otomatis) agar dapat ditelusuri klien
  meta        Json?

  @@index([invoiceId])
  @@index([siteId])
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  date      DateTime
  amount    Float
  method    String   @default("TRANSFER")
  ref       String?
  note      String?
  createdById String?
  createdBy   User?  @relation("PenerimaBayar", fields: [createdById], references: [id])
  createdAt DateTime @default(now())

  @@index([invoiceId])
}

/// Biaya langsung site di luar gaji: seragam, APD, perlengkapan, transport.
model SiteExpense {
  id          String   @id @default(cuid())
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  period      String
  category    String   @default("LAINNYA")
  description String
  amount      Float
  createdById String?
  createdBy   User?    @relation("PencatatBiaya", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([siteId, period])
}


// ═══════════════════════════════════════════════════════════════════════════
// PRIORITAS 2 — RISIKO & KEPATUHAN
//
// Yang diaudit lebih dulu saat pemeriksaan Baharkam atau klien adalah berkas
// personel: KTA, sertifikat Gada, SKCK, dan MCU. Modul ini menyimpan masa
// berlakunya, mengingatkan sebelum kedaluwarsa, dan mencegah penjadwalan
// personel yang berkasnya sudah mati.
// ═══════════════════════════════════════════════════════════════════════════

enum DocType {
  KTA_POLRI
  GADA_PRATAMA
  GADA_MADYA
  GADA_UTAMA
  SKCK
  MCU
  KTP
  SIM_A
  SIM_C
  DAMKAR
  P3K
  IJAZAH
  SERTIFIKAT_LAIN
}

enum DisciplineLevel {
  TEGURAN
  SP1
  SP2
  SP3
  PHK
}

enum EmploymentType {
  PROBATION
  PKWT
  PKWTT
}

enum EmploymentStatus {
  BERJALAN
  BERAKHIR
  DIPERPANJANG
  DIPUTUS
}

/// Berkas personel beserta masa berlakunya.
model PersonnelDocument {
  id           String    @id @default(cuid())
  guardId      String
  guard        User      @relation("BerkasPersonel", fields: [guardId], references: [id], onDelete: Cascade)
  type         DocType
  number       String?
  issuedAt     DateTime?
  expiresAt    DateTime?
  fileUrl      String?
  note         String?
  verifiedById String?
  verifiedBy   User?     @relation("PemeriksaBerkas", fields: [verifiedById], references: [id])
  verifiedAt   DateTime?
  /// Pengingat terakhir yang sudah dikirim (90/60/30/0) agar tidak berulang tiap hari
  lastAlertDays Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([guardId, type, number])
  @@index([guardId, type])
  @@index([expiresAt])
}

/// Syarat kompetensi yang dituntut kontrak pada satu site.
model CompetencyRequirement {
  id       String  @id @default(cuid())
  siteId   String
  site     Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  docType  DocType
  /// Jumlah personel bersertifikat yang wajib ada
  minCount Int     @default(1)
  /// Bila benar, jumlah itu harus terpenuhi pada tiap shift, bukan per site
  perShift Boolean @default(false)
  note     String?
  createdAt DateTime @default(now())

  @@unique([siteId, docType])
}

/// Rekam jejak kedisiplinan personel.
model Discipline {
  id         String          @id @default(cuid())
  guardId    String
  guard      User            @relation("PenerimaSanksi", fields: [guardId], references: [id], onDelete: Cascade)
  level      DisciplineLevel
  reason     String
  incidentId String?
  incident   Incident?       @relation(fields: [incidentId], references: [id])
  date       DateTime        @default(now())
  /// Masa berlaku sanksi — SP lazimnya gugur setelah enam bulan
  expiresAt  DateTime?
  fileUrl    String?
  note       String?
  issuedById String?
  issuedBy   User?           @relation("PemberiSanksi", fields: [issuedById], references: [id])
  createdAt  DateTime        @default(now())

  @@index([guardId, date])
}

/// Perjanjian kerja (PKWT/PKWTT) beserta pengingat perpanjangan.
model EmploymentContract {
  id        String           @id @default(cuid())
  guardId   String
  guard     User             @relation("KontrakKerja", fields: [guardId], references: [id], onDelete: Cascade)
  type      EmploymentType   @default(PKWT)
  number    String
  startDate DateTime
  endDate   DateTime?
  status    EmploymentStatus @default(BERJALAN)
  fileUrl   String?
  note      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([guardId, status])
  @@index([endDate])
}


// ═══════════════════════════════════════════════════════════════════════════
// PRIORITAS 3 — MESIN PENGISIAN POS
//
// Pos kosong adalah kerugian ganda: dipotong klien pada tagihan dan menjadi
// denda SLA. Modul ini menawarkan shift kosong kepada personel cadangan yang
// paling layak — kompetensi cocok, jarak terdekat, jam kerja belum melewati
// batas — lalu mencatat siapa yang mengambilnya.
// ═══════════════════════════════════════════════════════════════════════════

enum ReliefStatus {
  TERBUKA
  DIAMBIL
  DIBATALKAN
  KEDALUWARSA
}

enum ReliefResponse {
  BERSEDIA
  TIDAK_BISA
}

/// Tawaran pengisian shift yang ditinggalkan.
model ReliefOffer {
  id          String       @id @default(cuid())
  siteId      String
  site        Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  shiftId     String
  shift       Shift        @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  date        DateTime
  /// Jadwal yang batal, bila tawaran ini muncul dari seseorang yang berhalangan
  scheduleId  String?
  schedule    Schedule?    @relation(fields: [scheduleId], references: [id])
  reason      String
  status      ReliefStatus @default(TERBUKA)
  createdById String?
  createdBy   User?        @relation("PembuatTawaran", fields: [createdById], references: [id])
  takenById   String?
  takenBy     User?        @relation("PengambilTawaran", fields: [takenById], references: [id])
  takenAt     DateTime?
  /// Tawaran gugur sendiri setelah shift dimulai
  expiresAt   DateTime?
  note        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  candidates ReliefCandidate[]

  @@index([siteId, date])
  @@index([status])
}

/// Calon pengganti beserta alasan penilaiannya, disimpan agar keputusan
/// mesin dapat ditelusuri dan dipertanggungjawabkan.
model ReliefCandidate {
  id          String          @id @default(cuid())
  offerId     String
  offer       ReliefOffer     @relation(fields: [offerId], references: [id], onDelete: Cascade)
  guardId     String
  guard       User            @relation("CalonPengganti", fields: [guardId], references: [id], onDelete: Cascade)
  score       Float
  distanceM   Int?
  reasons     Json
  notifiedAt  DateTime?
  respondedAt DateTime?
  response    ReliefResponse?

  @@unique([offerId, guardId])
  @@index([guardId])
}


// ═══════════════════════════════════════════════════════════════════════════
// WILAYAH ADMINISTRATIF
//
// Kode dan nama wilayah Indonesia menurut Kepmendagri 300.2.2-2138 Tahun 2025:
// 38 provinsi, 514 kabupaten/kota, 7.285 kecamatan, 83.762 desa/kelurahan.
// Disimpan di basis data sendiri, bukan diambil dari layanan luar, agar
// pengisian alamat tetap jalan meski jaringan keluar sedang bermasalah.
// ═══════════════════════════════════════════════════════════════════════════

model Region {
  /// Kode berjenjang: "32" · "32.15" · "32.15.01" · "32.15.01.2001"
  code       String  @id
  name       String
  /// 1 provinsi · 2 kabupaten/kota · 3 kecamatan · 4 desa/kelurahan
  level      Int
  parentCode String?
  parent     Region? @relation("IndukWilayah", fields: [parentCode], references: [code])
  children   Region[] @relation("IndukWilayah")

  @@index([parentCode])
  @@index([level, name])
}
